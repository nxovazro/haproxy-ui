# Roxy-WI Production Environment Configuration
# This file should be kept secure and not committed to version control

# Application settings
ROXYWI_TESTING=0
ROXYWI_DEBUG=0
FLASK_DEBUG=0
FLASK_ENV=production

# Logging
ROXYWI_LOG_PATH=/var/log/roxy-wi
ROXYWI_LOG_LEVEL=INFO
ROXYWI_LOG_CONSOLE=0

# Secret key (MUST be changed in production)
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this secret and secure!
ROXYWI_SECRET_PHRASE=CHANGE_ME_IN_PRODUCTION_PLEASE_USE_RANDOM_KEY

# JWT Configuration
ROXYWI_JWT_ALGORITHM=RS256
ROXYWI_JWT_EXPIRES_HOURS=1
ROXYWI_JWT_PRIVATE_KEY_FILE=/var/lib/roxy-wi/keys/roxy-wi-key
ROXYWI_JWT_PUBLIC_KEY_FILE=/var/lib/roxy-wi/keys/roxy-wi-key.pub

# Database (use MySQL/MariaDB in production for reliability)
ROXYWI_USE_MYSQL=1
ROXYWI_MYSQL_HOST=your-db-host.example.com
ROXYWI_MYSQL_PORT=3306
ROXYWI_MYSQL_USER=roxy-wi
ROXYWI_MYSQL_PASSWORD=your_secure_db_password
ROXYWI_MYSQL_DB=roxywi

# Scheduler (should be enabled on one dedicated instance only)
ROXYWI_SCHEDULER_ENABLED=0

# Limits
ROXYWI_MAX_CONTENT_LENGTH=16777216  # 16MB
ROXYWI_MAX_FORM_MEMORY_SIZE=2097152  # 2MB

# Admin bootstrap password (only used on first startup)
# Must be at least 12 characters
ROXYWI_BOOTSTRAP_ADMIN_PASSWORD=your_secure_admin_password_here

# RabbitMQ configuration (for message queue)
ROXYWI_RABBITMQ_HOST=your-rabbitmq-host.example.com
ROXYWI_RABBITMQ_PORT=5672
ROXYWI_RABBITMQ_USER=roxy-wi
ROXYWI_RABBITMQ_PASSWORD=your_secure_rabbitmq_password

# Public URL for reverse proxy setup (if behind nginx/Apache)
ROXYWI_PUBLIC_URL=https://roxy-wi.example.com

# OpenID Connect (OIDC) settings
ROXYWI_OIDC_ENABLED=0
# ROXYWI_OIDC_PROVIDER_URL=https://your-oidc-provider.com
# ROXYWI_OIDC_CLIENT_ID=your_client_id
# ROXYWI_OIDC_CLIENT_SECRET=your_client_secret
